<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================ -->
    <!-- Base Theme                                   -->
    <!-- ============================================ -->
    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:colorBackground">@color/bg_main</item>

        <!-- Status Bar & Navigation -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Window Animation -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>

    <!-- ============================================ -->
    <!-- Splash Theme                                 -->
    <!-- ============================================ -->
    <style name="Theme.App.Splash" parent="Theme.App">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- ============================================ -->
    <!-- Window Animation                             -->
    <!-- ============================================ -->
    <style name="WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- ============================================ -->
    <!-- Buttons                                      -->
    <!-- ============================================ -->
    <style name="Btn.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Btn.Secondary" parent="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Btn.Ghost" parent="Btn.Primary">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- ============================================ -->
    <!-- Text Styles                                  -->
    <!-- ============================================ -->
    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.H1">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.H2">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.H3">
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
    </style>

    <style name="Text.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
    </style>

    <!-- ============================================ -->
    <!-- Dialog                                       -->
    <!-- ============================================ -->
    <style name="Dialog.Custom" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.Button.Negative</item>
    </style>

    <style name="Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
    </style>

    <style name="Dialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
    </style>

    <style name="Dialog.Button.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/error</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Dialog.Button.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============================================ -->
    <!-- Toolbar                                      -->
    <!-- ============================================ -->
    <style name="Toolbar.App" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/bg_main</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/Text.H3</item>
    </style>

</resources>
