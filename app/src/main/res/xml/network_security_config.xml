<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- ============================================ -->
    <!-- پیش‌فرض: فقط HTTPS                            -->
    <!-- ============================================ -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ============================================ -->
    <!-- دامنه‌ی اصلی — HTTPS فقط                     -->
    <!-- ============================================ -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">rosha-24.ir</domain>
        <domain includeSubdomains="true">www.rosha-24.ir</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
