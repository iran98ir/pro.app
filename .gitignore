# ================================================
# Git Ignore - Mu mu 
# ================================================

# --- Built application files ---
*.apk
*.aar
*.ap_
*.aab

# --- Files for the ART/Dalvik VM ---
*.dex

# --- Java class files ---
*.class

# --- Generated files ---
bin/
gen/
out/
release/

# --- Gradle files ---
.gradle/
build/

# --- Local configuration file (sdk path, etc) ---
local.properties

# --- Proguard folder generated by Eclipse ---
proguard/

# --- Log Files ---
*.log

# --- Android Studio / IntelliJ ---
.idea/
*.iml
*.iws
*.ipr

# --- Android Studio Navigation editor temp files ---
.navigation/

# --- Android Studio captures folder ---
captures/

# --- External native build ---
.externalNativeBuild/
.cxx/

# --- Keystore files (NEVER commit) ---
*.jks
*.keystore
keystore.properties

# --- Google Services (اختیاری - اگه Private هستی نگه دار) ---
# google-services.json

# --- macOS ---
.DS_Store

# --- Windows ---
Thumbs.db
Desktop.ini

# --- Linux ---
*~

# --- Node (برای ابزارهای جانبی) ---
node_modules/
