<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingBottom="@dimen/space_lg">

    <!-- عنوان -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/exit_title"
        android:textSize="@dimen/text_h3"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center" />

    <!-- پیام -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/exit_message"
        android:textSize="@dimen/text_body"
        android:textColor="#2D2D2D"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6" />

    <!-- دکمه‌ها -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnNo"
            style="@style/Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/exit_no" />

        <Button
            android:id="@+id/btnYes"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:backgroundTint="@color/error"
            android:text="@string/exit_yes" />

    </LinearLayout>

</LinearLayout>
